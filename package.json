{
  "name": "smaily-connect-admin",
  "version": "3.11.2",
  "description": "Admin UI bundle + RecEngineClient stub for the Smaily Connect WordPress plugin.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && npm run build:landing",
    "build:admin": "vite build --mode admin && npm run build:landing",
    "build:landing": "vite build --mode landing",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint admin/src public/js --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"admin/src/**/*.{ts,tsx,css}\" \"public/js/lib/**/*.ts\"",
    "ci:strict": "vendor/bin/phpcs --no-cache --runtime-set ignore_warnings_on_exit 1 && vendor/bin/phpstan analyse --memory-limit=2G --no-progress && vendor/bin/phpunit --testsuite=unit && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
