    "@puppeteer/browsers": {
      "tar-fs": "^3.0.9"
    },
    "@sentry/node": {
      "cookie": "^0.7.0"
    },
    "puppeteer-core@13": {
      "tar-fs": "^2.1.3",
      "ws": "^8.17.1"
    },
    "puppeteer-core@20": {
      "ws": "^8.17.1"
    },
    "webpack-dev-server": "^5.2.1"
  }
}
