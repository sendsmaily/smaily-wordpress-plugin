{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "smaily/newsletter-block",
	"version": "1.0.0",
	"title": "Smaily Sign-Up Form",
	"category": "widgets",
	"description": "Smaily newsletter subscription form.",
	"example": {},
	"attributes": {
		"show_name_field": {
			"type": "boolean",
			"default": false
		},
		"name_input_label": {
			"type": "string",
			"default": "Name"
		},
		"subscribe_button_label": {
			"type": "string",
			"default": "Subscribe"
		},
		"subscribe_button_bg_color": {
			"type": "string",
			"default": "var(--wp-admin-theme-color)"
		},
		"subscribe_button_text_color": {
			"type": "string",
			"default": "var(--wp-components-color-accent-inverted,#fff)"
		},
		"email_input_label": {
			"type": "string",
			"default": "Email"
		},
		"success_message": {
			"type": "string",
			"default": ""
		},
		"error_message": {
			"type": "string",
			"default": ""
		},
		"success_url": {
			"type": "string",
			"default": ""
		},
		"error_url": {
			"type": "string",
			"default": ""
		},
		"autoresponder_id": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": true,
		"color": {
			"background": true,
			"text": true,
			"button": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"html": false
	},
	"textdomain": "smaily",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
