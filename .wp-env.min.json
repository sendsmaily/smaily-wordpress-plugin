{
  "core": "https://wordpress.org/wordpress-6.5.zip",
  "phpVersion": "7.4",
  "testsEnvironment": false,
  "plugins": [
    "https://downloads.wordpress.org/plugin/woocommerce.7.7.2.zip",
    "https://downloads.wordpress.org/plugin/contact-form-7.5.7.7.zip",
    "https://downloads.wordpress.org/plugin/really-simple-captcha.2.1.zip"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true
  },
  "mappings": {
    "wp-content/plugins/smaily-connect": "."
  },
  "lifecycleScripts": {
    "afterStart": "([ -d blocks/node_modules ] || npm --prefix blocks run ci) && npm --prefix blocks run build && wp-env --config .wp-env.min.json run cli wp plugin activate smaily-connect"
  }
}
